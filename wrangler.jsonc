// Cloudflare Workers deploy: the web app's static assets, plus a Worker for
// /api that runs versus rooms, one Durable Object per room (DESIGN.md §18).
// Build: `pnpm --filter web build`; deploy: `pnpm exec wrangler deploy`.
// public/_headers (caching and CSP) applies to the assets as on Pages.
{
  "name": "daily-battle",
  "compatibility_date": "2026-10-01",
  "main": "./apps/server/src/index.ts",
  "assets": {
    "directory": "./apps/web/dist",
    // The room server reads this week's pool from the published schedules.
    "binding": "ASSETS",
    // Only /api reaches the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // One per protected name: its password hash and save (DESIGN.md §10).
      { "name": "ACCOUNTS", "class_name": "Account" },
    ],
  },
  // SQLite-backed Durable Objects (available on the free plan).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] },
  ],
  // Stats for the admin page (DESIGN.md §18a). CI applies the migrations before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-battle-stats",
      "database_id": "0b086e55-3549-4b79-8208-a31ceb79f6bd",
      "migrations_dir": "apps/server/migrations",
    },
  ],
}
