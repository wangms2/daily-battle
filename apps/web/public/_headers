# Cloudflare Pages response headers. Everything is self-hosted, so the CSP only
# allows this origin (inline style attributes are used for HP bars and sprites;
# blob: images are the share card's preview).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Hashed build output never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sprites/*
  Cache-Control: public, max-age=604800

/fx/*
  Cache-Control: public, max-age=604800

/audio/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

# Schedules are published weekly; always check for a fresh copy.
/schedule/*
  Cache-Control: no-cache
