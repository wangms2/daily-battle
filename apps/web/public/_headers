# Cloudflare Pages response headers. Everything is self-hosted, so the CSP only
# allows this origin, plus Cloudflare Web Analytics' beacon (lib/analytics.ts):
# its script, and where it reports. Inline style attributes are used for HP bars
# and sprites; blob: images are the share card's preview; 'wasm-unsafe-eval'
# lets the battle worker compile the Hard AI's engine.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Hashed build output never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sprites/*
  Cache-Control: public, max-age=604800

/fx/*
  Cache-Control: public, max-age=604800

/audio/*
  Cache-Control: public, max-age=604800

# Icons change name when they change (see index.html), so a day's cache is plenty.
/icons/*
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Schedules are published weekly; always check for a fresh copy.
/schedule/*
  Cache-Control: no-cache
